// Ejercicios de la Unidad 3.


// Ejercicio 1.
programa DetectaFiebre
inicio

	var float temperatura

	mostrar: "Ingrese su temperatura."
	ingresar: temperatura

	si temperatura > 37
		mostrar: "¡Ay, no! Tenés fiebre :c"
	sino
		mostrar: "¡Genial! Estás bien, no tenés fiebre :3"
	fin si
fin



// Ejercicio 2.
programa EsCoupe
inicio
	var integer nroDePuertas

	mostrar: "¿Cuántas puertas tiene el vehículo?"
	ingresar nroDePuertas
	
	si nroDePuertas = 2
		mostrar: "Ah, ¡es un coupé!"
	sino
		mostrar: "Ah... NO es un coupé."
fin



// Ejercicio 3.
programa PodesVotar
inicio

	var integer edad

	mostrar: "¡Hola! Ingresá tu edad a continuación."
	ingresar: edad
	
	si edad < 16
		mostrar: "¡No podés votar! Esperá hasta cumplir los 16..."
	
	sino
		mostrar: "¡Genial, tenés más de 16 años! Podés votar :)"
fin


// Ejercicio 4.
programa PodesSubir
inicio

	var float altura

	mostrar: "¡Hola, bienvenide al juego mecánico! :3"
	
	mostrar: "Ingresá tu altura a continuación."
	ingresar: altura
	
	si altura < 1.2
		mostrar: "¡No podés subirte! Sos demasiado bajite..."
		mostrar: "Volvé cuando estés más crecide! :3"
	
	sino
		mostrar: "¡Genial! Podés subir :)"
fin


// Ejercicio 5.
programa LaMejorRadio
inicio

