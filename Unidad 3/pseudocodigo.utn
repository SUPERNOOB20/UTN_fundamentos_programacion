// Ejercicio 21
programa NumerosDecreciente
inicio

	var integer numeroActual

	numeroActual = 100

	mientras numeroActual >= 0 hacer
		mostrar: numeroActual
		numeroActual--		// numeroActual = numeroActual - 1
	fin mientras
fin




// Ejercicio 22
programa EsVocal
inicio

	// Tipo de dato "char", en realidad.
	var string letra

	mostrar: "Ingresá una letra."
	ingresar: letra

	si letra = ("a" O "A" O "e" O "E" O "i" O "I" O "o" O "O" O "u" O "U")
		mostrar: "La letra ingresada es una vocal"
	sino
		mostrar: "La letra ingresada NO es una vocal"
fin
