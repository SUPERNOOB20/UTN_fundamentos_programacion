		caso "I"
			mostrar: "Estamos en Invierno."
		caso "V"
			mostrar: "Estamos en Verano."
		caso "O"
			mostrar: "Estamos en Otoño."
		sino
			mostrar: "Estación inválida... probá nuevamente"
	fin en caso de
fin


